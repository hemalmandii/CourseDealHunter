{
  "expo": {
    "name": "SkillLoot",
    "slug": "app",
    "scheme": "coursedealhunter",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coursedealhunter.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.coursedealhunter.app",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5880f63-8357-4d39-8ad9-4f6f48d9e5d8"
      },
      "oneSignalAppId": "55df49d7-440f-4388-8a46-5f16336358bb"
    },
    "owner": "hemalmandi"
  }
}